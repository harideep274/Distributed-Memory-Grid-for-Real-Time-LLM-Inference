{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run model-parallel demo",
      "type": "debugpy",
      "request": "launch",
      "module": "distributed_memgrid.demo",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run row-parallel demo",
      "type": "debugpy",
      "request": "launch",
      "module": "distributed_memgrid.row_parallel_demo",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
